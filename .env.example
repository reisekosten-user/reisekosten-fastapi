# Mistral API
MISTRAL_API_KEY=your_api_key_here
MISTRAL_MODEL=mistral-large-latest

# Optional
REQUEST_TIMEOUT_SECONDS=180

# SMTP (DMS-Archivierung per E-Mail)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DMS_EMAIL_TO=dms-import@example.com

# Login (Session-Cookies)
SESSION_SECRET=bitte-langen-zufaelligen-wert-eintragen

# Reisenden-Portal
PORTAL_BASE_URL=https://reisekosten-eu.onrender.com
PORTAL_TAGE_VORHER=5
CRON_SECRET=bitte-zufaelligen-wert-eintragen

# Flug-/Bahn-Alerts
AERODATABOX_API_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com